# Template for /etc/@PREFIX@-wiki/env. Install with: install -m 0600 -o root -g wiki
# Real values live only on the VM (mode 0600). Never commit a filled copy.

# Cloudflare Tunnel token (filled on the VM only)
TUNNEL_TOKEN=

# Upload door (H2): size cap in bytes and ref lifetime in seconds
LWK_UPLOAD_MAX_BYTES=52428800
LWK_UPLOAD_TTL_SECONDS=86400

# Backup (wiki-backup.sh). Leave empty to skip that half.
BACKUP_GIT_REMOTE=
BACKUP_GIT_BRANCH=main
BACKUP_EBS_VOLUME_ID=
AWS_DEFAULT_REGION=

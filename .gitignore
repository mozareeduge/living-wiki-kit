# Rebuildable / runtime state
_search/
_exports/interchange/
_audits/runtime/
_proposals/generated/
.pytest_cache/
scripts/__pycache__/
scripts/capture/__pycache__/
scripts/capture/tests/
scripts/capture/fixtures/
*.pyc

# Proposals log is a runtime queue (durable state lives in adjudicated records)
# _proposals/proposals.jsonl  # keep committed but inert; uncomment to ignore

# Harness runtime state (skills under .claude/skills/ stay tracked)
.claude/state/
.claude/sessions/
.claude/memory/
.harness-mem/
.harness-worktrees/
**/.claude/state/

# Secrets and machine-specific config
.env
.env.*
*.local.json

# OS noise
Thumbs.db
.DS_Store

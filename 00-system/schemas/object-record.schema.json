{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-wiki-kit.local/schemas/object-record.schema.json",
  "title": "Living Wiki object record",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,7}-obj-"
    },
    "type": {
      "const": "object"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "deprecated": true,
      "description": "Legacy semantic classification. New records should use labels and, where semantically necessary, relations or claims."
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[^\\r\\n\\u0000-\\u001f]*$"
      },
      "uniqueItems": true,
      "default": []
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
